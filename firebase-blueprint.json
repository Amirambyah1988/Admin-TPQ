{
  "entities": {
    "AdminEntry": {
      "title": "AdminEntry",
      "description": "Registry of verified TPQ Asatidz/Admin UIDs for RBAC.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "nama": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "nama", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user role and linkage metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["asatidz", "santri"]
        },
        "nama": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "santriId": {
          "type": "string",
          "maxLength": 128
        },
        "asatidzId": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "role", "nama", "email", "updatedAt"]
    },
    "TPQProfile": {
      "title": "TPQProfile",
      "description": "Institution profile and bank accounts for TPQ.",
      "type": "object",
      "properties": {
        "nama": { "type": "string", "minLength": 1, "maxLength": 150 },
        "logo": { "type": "string", "maxLength": 500 },
        "alamat": { "type": "string", "maxLength": 350 },
        "tahunBerdiri": { "type": "string", "maxLength": 20 },
        "badanHukum": { "type": "string", "maxLength": 150 },
        "noSkKemenag": { "type": "string", "maxLength": 120 },
        "telepon": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 160 },
        "rekeningList": {
          "type": "array",
          "description": "Up to 10 bank/QRIS accounts"
        },
        "isPublicProfile": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nama", "alamat", "rekeningList", "isPublicProfile", "updatedAt"]
    },
    "Asatidz": {
      "title": "Asatidz",
      "description": "Private teacher/Asatidz profile and login credentials (Admin-only).",
      "type": "object",
      "properties": {
        "nama": { "type": "string", "minLength": 1, "maxLength": 150 },
        "nik": { "type": "string", "minLength": 4, "maxLength": 40 },
        "username": { "type": "string", "maxLength": 80 },
        "password": { "type": "string", "maxLength": 120 },
        "tempatLahir": { "type": "string", "maxLength": 100 },
        "tanggalLahir": { "type": "string", "maxLength": 30 },
        "pendidikan": { "type": "string", "maxLength": 150 },
        "mengajar": { "type": "string", "enum": ["Iqro", "Al-Qur'an", "Keduanya"] },
        "alamat": { "type": "string", "maxLength": 350 },
        "tanggalMulaiTugas": { "type": "string", "maxLength": 30 },
        "foto": { "type": "string", "maxLength": 500 },
        "noHp": { "type": "string", "maxLength": 50 },
        "statusAktif": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nama", "nik", "mengajar", "statusAktif", "updatedAt"]
    },
    "Santri": {
      "title": "Santri",
      "description": "Private Santri PII record owned by parent/santri UID or Admin.",
      "type": "object",
      "properties": {
        "nama": { "type": "string", "minLength": 1, "maxLength": 150 },
        "nik": { "type": "string", "minLength": 4, "maxLength": 40 },
        "tempatLahir": { "type": "string", "maxLength": 100 },
        "tanggalLahir": { "type": "string", "maxLength": 30 },
        "alamat": { "type": "string", "maxLength": 350 },
        "terdaftarTanggal": { "type": "string", "maxLength": 30 },
        "foto": { "type": "string", "maxLength": 500 },
        "namaWali": { "type": "string", "maxLength": 150 },
        "noHpWali": { "type": "string", "maxLength": 50 },
        "jilid": { "type": "string", "maxLength": 50 },
        "username": { "type": "string", "maxLength": 120 },
        "password": { "type": "string", "maxLength": 120 },
        "jenisKelamin": { "type": "string", "enum": ["L", "P"] },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nama", "nik", "jilid", "username", "jenisKelamin", "ownerUid", "createdAt", "updatedAt"]
    },
    "SantriPublic": {
      "title": "SantriPublic",
      "description": "Non-PII public summary of Santri for Syahriah payment transparency board.",
      "type": "object",
      "properties": {
        "nama": { "type": "string", "minLength": 1, "maxLength": 150 },
        "jilid": { "type": "string", "maxLength": 50 },
        "foto": { "type": "string", "maxLength": 500 },
        "paidMonths": { "type": "array" },
        "isPublicSummary": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nama", "jilid", "paidMonths", "isPublicSummary", "updatedAt"]
    },
    "HafalanMasterItem": {
      "title": "HafalanMasterItem",
      "description": "Master list of Surahs, Duas, Hadiths, and Prayer readings.",
      "type": "object",
      "properties": {
        "kategori": { "type": "string", "enum": ["surat", "doa", "hadist", "shalat", "custom"] },
        "judul": { "type": "string", "minLength": 1, "maxLength": 200 },
        "deskripsi": { "type": "string", "maxLength": 400 },
        "arabic": { "type": "string", "maxLength": 1000 },
        "isPublicCurriculum": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["kategori", "judul", "isPublicCurriculum", "updatedAt"]
    },
    "SantriHafalanStatus": {
      "title": "SantriHafalanStatus",
      "description": "Per-santri memorization completion status.",
      "type": "object",
      "properties": {
        "santriId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "hafalanId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "lancar": { "type": "boolean" },
        "tanggalLancar": { "type": "string", "maxLength": 30 },
        "catatan": { "type": "string", "maxLength": 400 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["santriId", "ownerUid", "hafalanId", "lancar", "updatedAt"]
    },
    "LogProgressHarian": {
      "title": "LogProgressHarian",
      "description": "Daily Iqro and Al-Qur'an learning logs.",
      "type": "object",
      "properties": {
        "santriId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tanggal": { "type": "string", "maxLength": 30 },
        "jenisBacaan": { "type": "string", "enum": ["Iqro", "Al-Qur'an"] },
        "jilidAtauSurat": { "type": "string", "maxLength": 120 },
        "halamanAyat": { "type": "string", "maxLength": 120 },
        "lancar": { "type": "boolean" },
        "catatanGuru": { "type": "string", "maxLength": 500 },
        "asatidzNama": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["santriId", "ownerUid", "tanggal", "jenisBacaan", "jilidAtauSurat", "lancar", "createdAt", "updatedAt"]
    },
    "AbsensiSantri": {
      "title": "AbsensiSantri",
      "description": "Daily attendance record for Santri.",
      "type": "object",
      "properties": {
        "tanggal": { "type": "string", "maxLength": 30 },
        "santriId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "enum": ["Hadir", "Sakit", "Izin", "Alpa"] },
        "keterangan": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tanggal", "santriId", "ownerUid", "status", "updatedAt"]
    },
    "AbsensiAsatidz": {
      "title": "AbsensiAsatidz",
      "description": "Daily attendance record for Asatidz (Admin-only).",
      "type": "object",
      "properties": {
        "tanggal": { "type": "string", "maxLength": 30 },
        "asatidzId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "jamMasuk": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["Hadir", "Sakit", "Izin", "Alpa"] },
        "keterangan": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tanggal", "asatidzId", "jamMasuk", "status", "updatedAt"]
    },
    "PembayaranSyahriah": {
      "title": "PembayaranSyahriah",
      "description": "Monthly Syahriah fee payments and proof uploads.",
      "type": "object",
      "properties": {
        "santriId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "bulanList": { "type": "array" },
        "nominalPerBulan": { "type": "number" },
        "totalNominal": { "type": "number" },
        "tanggalBayar": { "type": "string", "maxLength": 30 },
        "metode": { "type": "string", "enum": ["Transfer Bank", "Tunai"] },
        "bankTujuan": { "type": "string", "maxLength": 150 },
        "buktiTransferUrl": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["Lunas", "Menunggu Konfirmasi", "Dibatalkan"] },
        "catatan": { "type": "string", "maxLength": 400 },
        "diverifikasiOleh": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["santriId", "ownerUid", "bulanList", "nominalPerBulan", "totalNominal", "tanggalBayar", "metode", "status", "createdAt", "updatedAt"]
    },
    "LaporanKeuangan": {
      "title": "LaporanKeuangan",
      "description": "Transparent TPQ financial ledger entries.",
      "type": "object",
      "properties": {
        "no": { "type": "number" },
        "tanggal": { "type": "string", "maxLength": 30 },
        "uraian": { "type": "string", "minLength": 1, "maxLength": 300 },
        "jenis": { "type": "string", "enum": ["Masuk", "Keluar"] },
        "nominal": { "type": "number" },
        "saldo": { "type": "number" },
        "keterangan": { "type": "string", "maxLength": 300 },
        "isPublicReport": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["no", "tanggal", "uraian", "jenis", "nominal", "saldo", "isPublicReport", "updatedAt"]
    },
    "DokumentasiKegiatan": {
      "title": "DokumentasiKegiatan",
      "description": "Photo gallery of TPQ activities.",
      "type": "object",
      "properties": {
        "judul": { "type": "string", "minLength": 1, "maxLength": 200 },
        "tanggal": { "type": "string", "maxLength": 30 },
        "kategori": { "type": "string", "maxLength": 100 },
        "deskripsi": { "type": "string", "maxLength": 800 },
        "fotoUrl": { "type": "string", "minLength": 1, "maxLength": 500 },
        "dibuatOleh": { "type": "string", "maxLength": 150 },
        "isPublicGallery": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["judul", "tanggal", "kategori", "fotoUrl", "isPublicGallery", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminEntry" },
      "description": "Admin UID registry for TPQ role enforcement."
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User role profiles isolated by UID."
    },
    "/tpq_profile/{profileId}": {
      "schema": { "$ref": "#/entities/TPQProfile" },
      "description": "Institution metadata and bank account settings."
    },
    "/asatidz/{asatidzId}": {
      "schema": { "$ref": "#/entities/Asatidz" },
      "description": "Private Asatidz records and credentials."
    },
    "/santri/{santriId}": {
      "schema": { "$ref": "#/entities/Santri" },
      "description": "Private Santri PII records."
    },
    "/santri_public/{santriId}": {
      "schema": { "$ref": "#/entities/SantriPublic" },
      "description": "Non-PII Santri summary for Syahriah transparency."
    },
    "/hafalan_master/{hafalanId}": {
      "schema": { "$ref": "#/entities/HafalanMasterItem" },
      "description": "Curriculum memorization master items."
    },
    "/hafalan_status/{statusId}": {
      "schema": { "$ref": "#/entities/SantriHafalanStatus" },
      "description": "Santri memorization fluency statuses."
    },
    "/progress_logs/{logId}": {
      "schema": { "$ref": "#/entities/LogProgressHarian" },
      "description": "Daily Iqro and Al-Qur'an progress logs."
    },
    "/absensi_santri/{absensiId}": {
      "schema": { "$ref": "#/entities/AbsensiSantri" },
      "description": "Daily attendance records for Santri."
    },
    "/absensi_asatidz/{absensiId}": {
      "schema": { "$ref": "#/entities/AbsensiAsatidz" },
      "description": "Daily attendance records for Asatidz."
    },
    "/syahriah/{syahriahId}": {
      "schema": { "$ref": "#/entities/PembayaranSyahriah" },
      "description": "Monthly Syahriah payments and proofs."
    },
    "/laporan_keuangan/{kasId}": {
      "schema": { "$ref": "#/entities/LaporanKeuangan" },
      "description": "Public cash transparency ledger."
    },
    "/dokumentasi/{dokId}": {
      "schema": { "$ref": "#/entities/DokumentasiKegiatan" },
      "description": "Activity photo gallery."
    }
  }
}
